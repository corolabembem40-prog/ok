:: ======================================
:: Maintenance Console - DEMO ONLY
:: ======================================

:DemoRoutine
title Maintenance Console
color 9C

echo Initializing Maintenance Console...
timeout /t 1 >nul

echo Verifying system components...
timeout /t 1 >nul

for /L %%i in (1,1,6) do (
    set /a percent=!random! %% 100
    echo Component %%i ........ !percent!%%
    timeout /t 1 >nul
)

timeout /t 2 >nul

for %%A in (
    Power
    NVMe
    Audio
) do (
    set /a score=!random! %% 100
    echo %%A Status: !score!%%
)

timeout /t 1 >nul

for %%S in (
    SSH
    DNS
    POP3
    Telnet
    HTTP
) do (
    set /a state=!random! %% 2
    if !state! EQU 0 (
        echo %%S ........ ONLINE
    ) else (
        echo %%S ........ STANDBY
    )
)

echo Check finished.
pause
goto :eof

:skipDemo
