:: ======================================
:: Security Check - DEMO ONLY
:: ======================================

:ScanRoutine
title Security Check
color 2A

echo Initializing Security Check...
timeout /t 1 >nul

echo Verifying system components...
timeout /t 1 >nul

for /L %%i in (1,1,3) do (
    set /a percent=!random! %% 100
    echo Component %%i ........ !percent!%%
    timeout /t 1 >nul
)

timeout /t 2 >nul

for %%A in (
    NVMe
    USB
    Storage
    Cooling
) do (
    set /a score=!random! %% 100
    echo %%A Status: !score!%%
)

echo Check finished.
pause
goto :eof

:skipScan
:: ======================================
:: END OF SECURITY CHECK BLOCK
:: ======================================

goto :skipVerify

:: ======================================
:: Component Check - DEMO ONLY
:: ======================================

:VerifyRoutine
title Component Check
color 3C

echo Initializing Component Check...
timeout /t 1 >nul

echo Verifying system components...
timeout /t 1 >nul

for /L %%i in (1,1,6) do (
    set /a percent=!random! %% 100
    echo Component %%i ........ !percent!%%
    timeout /t 1 >nul
)

echo.
echo Collecting statistics...
timeout /t 2 >nul

for %%A in (
    Power
    Audio
    Storage
    CPU
    Cooling
) do (
    set /a score=!random! %% 100
    echo %%A Status: !score!%%
)

echo Audit done.
pause
goto :eof

:skipVerify
:: ======================================
:: END OF COMPONENT CHECK BLOCK
:: ======================================
