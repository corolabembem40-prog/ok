    timeout /t 1 >nul
)

echo.
echo Collecting statistics...
timeout /t 2 >nul

for %%A in (
    Power
    Audio
    Storage
    CPU
    Cooling
) do (
    set /a score=!random! %% 100
    echo %%A Status: !score!%%
)

echo Audit done.
pause
goto :eof

