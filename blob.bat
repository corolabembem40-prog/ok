    set /a percent=!random! %% 100
    echo Component %%i ........ !percent!%%
    timeout /t 1 >nul
)

echo.
echo Collecting statistics...
timeout /t 2 >nul

for %%A in (
    Graphics
    USB
    Power
    SATA
    Storage
    NVMe
) do (
    set /a score=!random! %% 100
    echo %%A Status: !score!%%
)

echo Preview complete.
pause
goto :eof

